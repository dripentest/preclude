#!/usr/bin/env python3
"""Standalone launcher so the tool runs straight from a clone, no install needed.

    git clone <repo> && ./preclude/bin/preclude scan https://target.example
"""

import os
import sys

# Make the repository root importable regardless of the current directory.
_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if _ROOT not in sys.path:
    sys.path.insert(0, _ROOT)

from preclude.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
